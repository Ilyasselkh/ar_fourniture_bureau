<odoo>
    <record id="view_ar_fb_article_list" model="ir.ui.view">
        <field name="name">ar.fb.article.list</field>
        <field name="model">ar.fb.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="description"/>
                <field name="disponible" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ar_fb_article_form" model="ir.ui.view">
        <field name="name">ar.fb.article.form</field>
        <field name="model">ar.fb.article</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="description"/>
                        <field name="disponible" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ar_fb_article" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">ar.fb.article</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>